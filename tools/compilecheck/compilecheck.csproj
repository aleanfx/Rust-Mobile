<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A fast semantic compile of the game code without Unity, so mistakes show up in seconds instead
    of after a cloud build. It compiles Core and Game against community reference assemblies from
    NuGet. They are older than the editor the game ships with (Unity 6.3), so a pass here is not
    proof, and the URP-only code (OXFALL_URP) and Editor code are not covered: the cloud build
    remains the real check.   Run:  dotnet build tools/compilecheck -p:Platform=Android|WebGL
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS1591;NU1701;NU1603;MSB3277;CS0649</NoWarn>
    <DefineConstants Condition="'$(Platform)' == 'WebGL'">$(DefineConstants);UNITY_WEBGL</DefineConstants>
    <DefineConstants Condition="'$(Platform)' != 'WebGL'">$(DefineConstants);UNITY_ANDROID</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Oxfall/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Oxfall/Scripts/Game/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" IncludeAssets="compile" />
  </ItemGroup>
</Project>
